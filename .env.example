# =====================================================================
# IRIS - Intelligent Incident Response System
# Environment Configuration Template
# =====================================================================

# --- HINDSIGHT PERSISTENT AGENT MEMORY ---
# URL of your Hindsight instance (Self-hosted or Cloud)
# Default local instance: http://localhost:8888
# Cloud instance: https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=http://localhost:8888

# Hindsight API key (required for Cloud or secured self-hosted instances)
HINDSIGHT_API_KEY=

# Dedicated memory bank ID for IRIS incidents
HINDSIGHT_BANK_ID=iris-incident-memory

# Demo / Fallback Mode (true/false)
# Set to 'true' to force local demo memory bank without requiring an active Hindsight daemon
# Set to 'false' to use real Hindsight connection
HINDSIGHT_DEMO_MODE=false

# --- LLM CONFIGURATION ---
# Supported providers: openai, gemini, custom, local
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini Configuration (optional alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- APPLICATION SETTINGS ---
IRIS_APP_NAME=IRIS
IRIS_APP_ENV=development
IRIS_LOG_LEVEL=INFO
IRIS_DATABASE_PATH=iris.db
